# 国内镜像配置（用户环境要求：直连境外源会卡在某些包上）
#
# 放在项目里而不是只放在用户目录，是为了让 `pnpm install` 在任何机器上都可复现——
# 新人 clone 下来不需要额外问「该配哪个源」。
registry=https://registry.npmmirror.com

# 带二进制产物的包走 npmmirror 的镜像站（否则这些会在 postinstall 阶段卡住）
electron_mirror=https://npmmirror.com/mirrors/electron/
node_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors/
sharp_binary_host=https://npmmirror.com/mirrors/sharp
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips
sass_binary_site=https://npmmirror.com/mirrors/node-sass
playwright_download_host=https://npmmirror.com/mirrors/playwright
puppeteer_download_host=https://npmmirror.com/mirrors/chromium-browser-snapshots

# pnpm 行为
auto-install-peers=true
strict-peer-dependencies=false
# CodeMirror / Naive UI 的 peer 依赖版本声明宽松，不必因 peer 冲突中断安装
resolution-mode=highest

# 取包超时与重试（镜像偶发抖动时不要直接失败）
fetch-retries=3
fetch-retry-maxtimeout=60000
fetch-timeout=120000
