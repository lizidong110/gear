# WorkBuddy 项目数据（不纳入版本控制）
.workbuddy/

# Go 构建产物
/bin/
*.exe
*.test
*.out

# 测试日志落盘（scripts/gate.sh 产出，不纳入版本控制）
/build/testlogs/

# 执行记录 SQLite 持久化库及其 WAL 侧车文件。
# 2026-09-21 起默认落点不再是相对 cwd 的 build/gear.db，而是 <GEAR_HOME>/exec.db
# （GEAR_HOME 未设时 <HOME>/.gear/exec.db，见 internal/gearhome/gearhome.go）；
# 测试由 gearhome.IsolateForTest() 重定向到临时目录。
# 保留这三个忽略项仅为防止历史遗留产物被误入库（WAL 模式会生成 -shm/-wal）。
**/gear.db
**/gear.db-shm
**/gear.db-wal

# 编辑器 / OS 临时文件
.idea/
.vscode/
*.swp
.DS_Store
apps/

# 用户本地扩展配置（由 extensions.example.yaml 复制而来，不纳入版本控制）
extensions.yaml

# 「发布后用户自助」演示的临时产物（sidecar 脚本 / 本地 registry / 示例 YAML）
/.postpublish-demo/

# Web UI 插件（plugin/web-ui）：依赖与构建产物不入库；
# 注意 src/logic/generated/enums.ts 是生成物但**必须入库**（契约守卫要逐字节比对），故不在此忽略。
**/node_modules/
**/dist/
plugin/web-ui/coverage/
build/
# 演示目录：提交顶层的演示 YAML 与 README，忽略子目录/临时产物
examples/*
!examples/*.yaml
!examples/*.md
**/__pycache__
